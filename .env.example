# rag-crucible — environment variables
# Copy to .env (git-ignored). Only needed for hosted providers; the local and
# fake providers run with no keys at all.

# Optional filesystem overrides. Worker reports default to
# results/<spec-name>/<run-id>/; containers keep them on the artifact volume.
# CRUCIBLE_RESULTS_DIR=results

# Cohere provider (pipeline stages with `provider: cohere`)
COHERE_API_KEY=

# OpenAI-compatible provider (pipeline stages with `provider: openai`)
OPENAI_API_KEY=
# Point at any OpenAI-compatible server (vLLM, Ollama, etc.); default is api.openai.com
OPENAI_BASE_URL=
